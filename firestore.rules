rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }
    function isValidString(val, maxLen) {
      return val is string && val.size() > 0 && val.size() <= maxLen;
    }

    // ── Rate limits (Cloud Function only — clients denied) ───────
    match /_rate_limits/{uid} {
      allow read, write: if false;
    }

    // ── Églises (OpenStreetMap cache) ─────────────────────────────
    match /eglises/{churchId} {
      allow read: if isAuth();
      allow create: if isAuth()
        && isValidString(request.resource.data.nom, 200)
        && request.resource.data.lat is number
        && request.resource.data.lon is number;
      allow update: if isAuth()
        && isValidString(request.resource.data.nom, 200);
      allow delete: if false;
    }

    // ── Horaires de messes ────────────────────────────────────────
    match /horaires/{scheduleId} {
      allow read: if isAuth();
      allow create: if isAuth()
        && isOwner(request.resource.data.soumis_par)
        && isValidString(request.resource.data.egliseId, 100)
        && request.resource.data.jour is number
        && request.resource.data.jour >= 0
        && request.resource.data.jour <= 6;
      allow update: if isOwner(resource.data.soumis_par)
        && request.resource.data.soumis_par == resource.data.soumis_par
        && request.resource.data.egliseId == resource.data.egliseId;
      allow delete: if isOwner(resource.data.soumis_par);
    }

    // ── Forum / posts communauté ──────────────────────────────────
    match /posts/{postId} {
      allow read: if isAuth();
      allow create: if isAuth()
        && isOwner(request.resource.data.authorId)
        && isValidString(request.resource.data.content, 2000)
        && isValidString(request.resource.data.title, 200);
      allow update: if isOwner(resource.data.authorId)
        && isValidString(request.resource.data.content, 2000)
        && request.resource.data.authorId == resource.data.authorId;
      allow delete: if isOwner(resource.data.authorId);

      // Réponses/commentaires
      match /replies/{replyId} {
        allow read: if isAuth();
        allow create: if isAuth()
          && isOwner(request.resource.data.authorId)
          && isValidString(request.resource.data.content, 1000);
        allow update: if isOwner(resource.data.authorId)
          && isValidString(request.resource.data.content, 1000)
          && request.resource.data.authorId == resource.data.authorId;
        allow delete: if isOwner(resource.data.authorId);
      }
    }

    // ── Prières communautaires ────────────────────────────────────
    match /community_prayers/{prayerId} {
      allow read: if isAuth();
      allow create: if isAuth()
        && isOwner(request.resource.data.userId)
        && isValidString(request.resource.data.text, 1000);
      allow update: if isOwner(resource.data.userId)
        && isValidString(request.resource.data.text, 1000)
        && request.resource.data.userId == resource.data.userId;
      allow delete: if isOwner(resource.data.userId);
    }

    // ── Profils utilisateurs ──────────────────────────────────────
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && isValidString(request.resource.data.displayName, 100);
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['uid', 'createdAt']);
      allow delete: if false;

      // Progression pèlerinage (sous-collection)
      match /pilgrimage_progress/{routeId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ── Intentions de prière ──────────────────────────────────────
    match /prayer_intentions/{intentionId} {
      allow read: if isAuth();
      allow create: if isAuth()
        && isOwner(request.resource.data.userId)
        && isValidString(request.resource.data.intention, 500);
      allow update: if isOwner(resource.data.userId)
        && isValidString(request.resource.data.intention, 500)
        && request.resource.data.userId == resource.data.userId;
      allow delete: if isOwner(resource.data.userId);
    }

    // ── Tout le reste : refusé ────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
